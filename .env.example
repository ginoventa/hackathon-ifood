# Copie este arquivo para .env e preencha os valores.

# Chave da API do Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo do Gemini usado pelo agente.
GEMINI_MODEL=gemini-flash-latest

# "live" usa o MCP real do iFood (precisa conectar a conta).
# "mock" usa dados simulados, sem conta e sem pedidos reais.
IFOOD_MODE=live

# Envio real do pedido ao iFood após a confirmação do usuário na tela de revisão.
ALLOW_SUBMIT_ORDER=true

# Porta da interface/API.
PORT=5173

# Configurações avançadas do MCP do iFood (normalmente não precisam mudar).
# IFOOD_MCP_URL=https://consumer-mcp.ifood.com.br/marketplace
# IFOOD_CLIENT_ID=v1QQLHbVAuTz-kbov2vCst8bt2oxu8qh
# IFOOD_OAUTH_CALLBACK_PORT=8080
