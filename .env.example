# Copie este arquivo para .env e preencha os valores (não renomeie: o .env.example fica no git).

# LLM do agente: "chatgpt" (assinatura do ChatGPT; rode `npm run login-chatgpt`)
# ou "gemini" (chave da API do Gemini).
# Atenção: o modo "chatgpt" usa uma integração EXPERIMENTAL e NÃO OFICIAL do LangChain.
LLM_PROVIDER=chatgpt
# Modelos aceitos numa conta Plus: gpt-5.6-terra, gpt-5.6-luna, gpt-5.6-sol, gpt-6-luna, gpt-6-sol.
CHATGPT_MODEL=gpt-5.6-terra

# Chave da API do Gemini (só para LLM_PROVIDER=gemini): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Credenciais do agente cadastrado no MCP Portal (https://mcp-developer.ifood.com.br):
# Meus agentes > (seu agente) > Credenciais de acesso. O Client Secret aparece uma única vez.
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
# Deve ser EXATAMENTE a "Redirect URL (Callback URL)" cadastrada no agente.
IFOOD_REDIRECT_URI=http://localhost:8080/callback
# Escopos técnicos liberados para o agente após a homologação (separados por espaço).
# Deixe vazio para usar os escopos padrão do agente.
IFOOD_SCOPES=

# Envio do pedido ao iFood após a confirmação do usuário na tela de revisão.
# Atenção: pedidos de teste pagos (ex.: via PIX) não são reembolsados.
ALLOW_SUBMIT_ORDER=true

# Porta da interface/API.
PORT=5173

# Configurações avançadas (normalmente não precisam mudar).
# IFOOD_MCP_URL=https://consumer-mcp.ifood.com.br/marketplace
# IFOOD_AUTHORIZE_URL=https://id.ifood.com.br/authorize
# IFOOD_TOKEN_URL=https://id.ifood.com.br/token
# IFOOD_REVOKE_URL=https://id.ifood.com.br/revoke
